# ---> NexaBank environment template — copy to `.env` (gitignored) and adjust locally.
# Backend reads DATABASE_URL / DATABASE_USERNAME / DATABASE_PASSWORD.
# docker-compose reads POSTGRES_*.

# PostgreSQL (Docker)
POSTGRES_DB=nexabank
POSTGRES_USER=nexabank
POSTGRES_PASSWORD=nexabank

# Backend (Spring Boot) — matches the Docker defaults above.
DATABASE_URL=jdbc:postgresql://localhost:5432/nexabank
DATABASE_USERNAME=nexabank
DATABASE_PASSWORD=nexabank

# Frontend -> backend base URL (see frontend/src/environments/*)
# API_BASE_URL=http://localhost:8080

# Spring profile: dev | prod (default: dev for local work)
SPRING_PROFILES_ACTIVE=dev

# CORS (comma-separated if you need more origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# JWT (Phase 3) — signing secret for HS256. MUST be at least 32 bytes.
# Generate one locally, e.g.: openssl rand -base64 48
# NEVER commit a real secret. Production MUST set this env var;
# the backend fails fast at startup when it is missing.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes!!

# JWT access-token lifetime in milliseconds (default: 3600000 = 1h)
JWT_EXPIRATION_MS=3600000

# Development seed users (dev profile only, never production).
# Password for customer1 / employee1 / fraud1 / admin1.
# Default when unset: Password123! (local development only)
# NEXABANK_DEV_SEED_PASSWORD=Password123!

# Redis (Phase 7) — cache + rate-limit state. Non-authoritative.
# Empty password = open local dev; set one for any shared environment.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
APP_REDIS_ENABLED=true

# Kafka (Phase 7) — async domain-event feed via transactional outbox.
# The broker being down never blocks money movement (events stay PENDING).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_KAFKA_ENABLED=true

# Rate limiting (Phase 7) — fixed-window quotas; 429 + Retry-After on excess.
APP_RATE_LIMIT_ENABLED=true

# Outbox publisher (Phase 7) — scheduled Kafka relay for committed events.
APP_OUTBOX_PUBLISHER_ENABLED=true
